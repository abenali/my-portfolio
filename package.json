{
  "name": "webbendigital-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio site quality checks",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"*.html\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint \"js/**/*.js\""
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "htmlhint": "^1.6.3",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.1"
  }
}
